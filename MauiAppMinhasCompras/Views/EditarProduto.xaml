<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.EditarProduto"
             Title="{Binding Descricao}">
    
        <ContentPage.ToolbarItems>
            <!-- Botão "Salvar" localizado na barra superior da tela -->
            <ToolbarItem Text="Salvar" Clicked="ToolbarItem_Clicked" />
        </ContentPage.ToolbarItems>

        <VerticalStackLayout Spacing="10" Padding="10">
            <Label Text="Descrição do Produto:" />

            <!-- Campo numérico para informar a quantidade -->
            <Entry x:Name="txt_descricao" Text="{Binding Descricao}"/>

            <Label Text="Quantidade:" />

            <!-- Campo numérico para informar a quantidade -->
        <Entry x:Name="txt_quantidade" Keyboard="Numeric" Text="{Binding Quantidade}" />

            <Label Text="Preço Unitário:" />

            <!-- Campo numérico para informar o preço unitário -->
        <Entry x:Name="txt_preco" Keyboard="Numeric" Text="{Binding Preco}" />
        </VerticalStackLayout>
</ContentPage>